---
pagination:
  data: redirects
  size: 1
  alias: r
permalink: "{{ r.from }}"
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Moved: {{ r.title }}</title>
  <link rel="canonical" href="{{ site.url }}{{ r.to }}">
  <meta name="robots" content="noindex">
  <meta http-equiv="refresh" content="0; url={{ r.to }}">
  <script>location.replace({{ r.to | dump | safe }} + location.hash);</script>
</head>
<body>
  <p>This page moved to <a href="{{ r.to }}">{{ r.title }}</a>.</p>
</body>
</html>
